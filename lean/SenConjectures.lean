/-
Finite arithmetic behind the paper "The Conjectures of Ashoke Sen".

Everything here is computed inside the Lean 4 kernel from the definitions of the
theta functions, the Dedekind eta function and the Eisenstein series, with no
external input: the Fourier coefficients of 1/Phi_10 and of the Siegel form of the
Z_2 toroidal orbifold are obtained by expanding the Borcherds-type product, exactly
as in code/siegel_dyons.py, and the statements are proved by `decide +kernel`.

The expansion is long, so it is checked in stages.  The twisted elliptic genera and
the partial products after each value of the exponent of e^{2 pi i rho} are written
in the file as data blocks (`Gtor120`, `tor2_0`, … below); the kernel verifies that
each block is what the definitions produce from the previous one, and the theorems
about the tables are assembled from these steps by `Eq.trans`.  The data blocks are
therefore certificates, not inputs: a wrong block makes its step fail.

Checked with Lean 4.34.1 and no library beyond the core.  Run

    lean SenConjectures.lean

The file prints `'Sen.<name>' depends on axioms: [propext]` or
`'Sen.<name>' does not depend on any axioms` for every theorem; none uses `sorry`,
`Classical.choice` or `Lean.ofReduceBool`.
-/

namespace Sen

/-! ### Series in two variables

A series in `x = q^{1/8}` (exponent a natural number) and `y` (exponent an integer)
is an association list of monomials with integer coefficients. -/

abbrev S2 := List ((Nat × Int) × Int)

/-- Lexicographic order on the exponents; every series is kept sorted by it. -/
def ltKey2 (a b : Nat × Int) : Bool := a.1 < b.1 ∨ (a.1 = b.1 ∧ a.2 < b.2)

/-- Merge of two sorted series, adding the coefficients of equal exponents. -/
def merge2Aux : Nat → S2 → S2 → S2
  | 0, a, b => a ++ b
  | _ + 1, [], b => b
  | _ + 1, a, [] => a
  | n + 1, (ka, ca) :: ra, (kb, cb) :: rb =>
    if ka = kb then (if ca + cb = 0 then merge2Aux n ra rb else (ka, ca + cb) :: merge2Aux n ra rb)
    else if ltKey2 ka kb then (ka, ca) :: merge2Aux n ra ((kb, cb) :: rb)
    else (kb, cb) :: merge2Aux n ((ka, ca) :: ra) rb

def merge2 (a b : S2) : S2 := merge2Aux (a.length + b.length) a b

def addTerm2 (s : S2) (k : Nat × Int) (c : Int) : S2 :=
  if c = 0 then s else merge2 s [(k, c)]

def S2.add (a b : S2) : S2 := merge2 a b

def S2.scale (m : Int) (a : S2) : S2 :=
  if m = 0 then [] else a.map (fun t => (t.1, m * t.2))

/-- Product truncated at `x^xmax`: each term of `a` shifts `b`, which stays sorted, and the
shifted copies are merged. -/
def S2.mul (a b : S2) (xmax : Nat) : S2 :=
  a.foldl (fun acc ta =>
    merge2 acc ((b.filter (fun tb => ta.1.1 + tb.1.1 ≤ xmax)).map
      (fun tb => ((ta.1.1 + tb.1.1, ta.1.2 + tb.1.2), ta.2 * tb.2)))) []

def S2.coeff (a : S2) (k : Nat × Int) : Int :=
  match a.find? (fun t => t.1 = k) with
  | some t => t.2
  | none => 0

/-- Inverse of a series whose constant term is `1`: `1/(1+r) = Σ (-r)^n`. -/
def S2.inv (a : S2) (xmax : Nat) : S2 :=
  let r : S2 := (a.filter (fun t => t.1 ≠ (0, 0))).map (fun t => (t.1, -t.2))
  let rec go : Nat → S2 → S2 → S2
    | 0, _, acc => acc
    | n + 1, term, acc =>
      let term' := S2.mul term r xmax
      if term' = [] then acc else go n term' (S2.add acc term')
  go (xmax + 2) [((0, 0), 1)] [((0, 0), 1)]

/-! ### Binomial coefficients, divisor sums -/

/-- `choose n k` by the multiplicative formula, exact at every step. -/
def chooseAux : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, acc => acc
  | i + 1, n, k, acc => chooseAux i n k (acc * (n - k + (k - i)) / (k - i))

def choose (n k : Nat) : Nat := if k ≤ n then chooseAux k n k 1 else 0

def sigma (n : Nat) : Nat :=
  (List.range (n + 1)).foldl (fun acc d => if d ≠ 0 ∧ n % d = 0 then acc + d else acc) 0

def parity (n : Nat) : Int := if n % 2 = 0 then 1 else -1

def natSq (n : Int) : Nat := (n * n).toNat

/-! ### Theta functions, eta, Eisenstein series

`theta k xmax` returns the series of `θ_k(τ, z)` in `x = q^{1/8}` with the exponent of
`y` recorded in half units (the factor `-i` of `θ_1` is dropped and restored in `B`). -/

def theta (kind : Nat) (xmax : Nat) : S2 :=
  (List.range 81).foldl (fun acc (i : Nat) =>
    let n : Int := (i : Int) - 40
    if kind = 1 ∨ kind = 2 then
      let e := natSq (2 * n + 1)
      let c : Int := if kind = 1 then (if (n % 2 = 0) then 1 else -1) else 1
      if e ≤ xmax then addTerm2 acc (e, 2 * n + 1) c else acc
    else
      let e := natSq (2 * n)
      let c : Int := if kind = 3 then 1 else (if n % 2 = 0 then 1 else -1)
      if e ≤ xmax then addTerm2 acc (e, 2 * n) c else acc) []

/-- Square of a series in half-integral powers of `y`, written in integral powers. -/
def sqHalf (s : S2) (xmax : Nat) : S2 :=
  (S2.mul s s xmax).map (fun t => ((t.1.1, t.1.2 / 2), t.2))

def atZero (s : S2) : S2 := s.foldl (fun acc t => addTerm2 acc (t.1.1, 0) t.2) []

def shiftX (s : S2) (d : Nat) : S2 := s.map (fun t => ((t.1.1 - d, t.1.2), t.2))

/-- `Π_{n ≥ 1} (1 - q^n)^{-p}` with `q = x^8`, through the binomial series of each factor. -/
def etaInvPow (p : Nat) (xmax : Nat) : S2 :=
  (List.range (xmax / 8 + 1)).foldl (fun acc i =>
    let n := i + 1
    if 8 * n ≤ xmax then
      let f : S2 := (List.range (xmax / (8 * n) + 1)).map
        (fun m => ((8 * n * m, 0), (choose (m + p - 1) (p - 1) : Int)))
      S2.mul acc f xmax
    else acc) [((0, 0), 1)]

/-- `E(τ) = 1 - 24 Σ σ(n) q^n` evaluated at `τ`, `2τ`, `τ/2` or `(τ+1)/2`:
`mult` is the exponent of `x` per unit of `n` (8, 16, 4, 4) and `shift` the sign twist. -/
def eis (mult shift xmax : Nat) : S2 :=
  (List.range (xmax / mult + 1)).foldl (fun acc i =>
    let n := i + 1
    if mult * n ≤ xmax then
      addTerm2 acc (mult * n, 0) (-24 * (sigma n : Int) * (if shift = 1 then parity n else 1))
    else acc) [((0, 0), 1)]

/-- The weight-two form of `Γ_0(2)`: `E_2(τ) = 2E(2τ) - E(τ)`, and its images under
`τ ↦ τ/2`, `τ ↦ (τ+1)/2`. -/
def E2 (xmax : Nat) : S2 := S2.add (S2.scale 2 (eis 16 0 xmax)) (S2.scale (-1) (eis 8 0 xmax))
def E2half (xmax : Nat) : S2 := S2.add (S2.scale 2 (eis 8 0 xmax)) (S2.scale (-1) (eis 4 0 xmax))
def E2halfShift (xmax : Nat) : S2 := S2.add (S2.scale 2 (eis 8 0 xmax)) (S2.scale (-1) (eis 4 1 xmax))

/-- `8A = 8 Σ_{i=2,3,4} θ_i(τ,z)^2 / θ_i(τ,0)^2`, the elliptic genus of K3. -/
def eightA (xmax : Nat) : S2 :=
  let th2 := theta 2 (xmax + 2)
  let th3 := theta 3 xmax
  let th4 := theta 4 xmax
  -- θ_2(τ,0)/2 = x (1 + x^8 + x^24 + ...): numerator and denominator shifted by x^2
  let num2 := shiftX (sqHalf th2 (xmax + 2)) 2
  let den2 := shiftX (sqHalf (atZero th2) (xmax + 2)) 2   -- (θ_2(τ,0)/x)^2 / 4, constant term 1
  let den2 := den2.map (fun t => (t.1, t.2 / 4))
  let t2 := S2.scale 2 (S2.mul num2 (S2.inv den2 xmax) xmax)
  let t3 := S2.scale 8 (S2.mul (sqHalf th3 xmax) (S2.inv (sqHalf (atZero th3) xmax) xmax) xmax)
  let t4 := S2.scale 8 (S2.mul (sqHalf th4 xmax) (S2.inv (sqHalf (atZero th4) xmax) xmax) xmax)
  S2.add (S2.add t2 t3) t4

/-- `B = η^{-6} θ_1(τ,z)^2`, with `θ_1^2 = -(Σ (-1)^n x^{(2n+1)^2} y^{n+1/2})^2`
and `η^{-6} = x^{-2} Π (1-q^n)^{-6}`. -/
def Bseries (xmax : Nat) : S2 :=
  let th1sq := S2.scale (-1) (sqHalf (theta 1 (xmax + 2)) (xmax + 2))
  shiftX (S2.mul th1sq (etaInvPow 6 (xmax + 2)) (xmax + 2)) 2

/-! ### Twisted elliptic genera

Each model gives the list of `(r, s, 6 F^{(r,s)})`; the factor 6 keeps the arithmetic
integral and is divided out exactly in `expo`. -/

abbrev Genera := List ((Nat × Nat) × S2)

def generaHet (xmax : Nat) : Genera := [((0, 0), S2.scale 6 (eightA xmax))]

/-- The `Z_2` toroidal orbifold of type II on `T^6` (Chattopadhyaya–David, eq. (4.2)):
`F^{(0,0)} = 0`, `F^{(0,1)} = 8A/3 - 4BE_2(τ)/3`, `F^{(1,0)} = 8A/3 + 2BE_2(τ/2)/3`,
`F^{(1,1)} = 8A/3 + 2BE_2((τ+1)/2)/3`. -/
def generaTor2 (xmax : Nat) : Genera :=
  let A8 := eightA xmax
  let B := Bseries xmax
  [((0, 0), []),
   ((0, 1), S2.add (S2.scale 2 A8) (S2.scale (-8) (S2.mul B (E2 xmax) xmax))),
   ((1, 0), S2.add (S2.scale 2 A8) (S2.scale 4 (S2.mul B (E2half xmax) xmax))),
   ((1, 1), S2.add (S2.scale 2 A8) (S2.scale 4 (S2.mul B (E2halfShift xmax) xmax)))]

/-- The 2A CHL orbifold (David–Jatkar–Sen): `F^{(0,0)} = 4A`,
`F^{(0,1)} = 4A/3 - 2BE_2(τ)/3`, `F^{(1,0)} = 4A/3 + BE_2(τ/2)/3`,
`F^{(1,1)} = 4A/3 + BE_2((τ+1)/2)/3`. -/
def generaChl2 (xmax : Nat) : Genera :=
  let A8 := eightA xmax
  let B := Bseries xmax
  [((0, 0), S2.scale 3 A8),
   ((0, 1), S2.add A8 (S2.scale (-4) (S2.mul B (E2 xmax) xmax))),
   ((1, 0), S2.add A8 (S2.scale 2 (S2.mul B (E2half xmax) xmax))),
   ((1, 1), S2.add A8 (S2.scale 2 (S2.mul B (E2halfShift xmax) xmax)))]

def lookupGenus (G : Genera) (rs : Nat × Nat) : S2 :=
  match G.find? (fun t => t.1 = rs) with
  | some t => t.2
  | none => []

/-- Exponent of the factor `(1 - e^{2πi(k'σ + lρ + jv)})`, `k' = k2/N`:
`Σ_s e^{2πi s l/N} c^{(r,s)}_b(4k'l - j^2)` with `r = k2 mod N`; `none` if not integral. -/
def expo (G : Genera) (N k2 l : Nat) (j : Int) : Option Int :=
  let r := k2 % N
  let n8 := 8 * k2 * l / N
  if (8 * k2 * l) % N ≠ 0 then none else
  let tot := (List.range N).foldl (fun acc s =>
    let c := S2.coeff (lookupGenus G (r, s)) (n8, j)
    acc + c * (if (s * l) % N = 0 then 1 else -1)) 0
  if tot % 6 = 0 then some (tot / 6) else none

/-! ### Series in `(ρ, σ, v)` and the product formula -/

abbrev S3 := List ((Nat × Nat × Int) × Int)

def ltKey3 (a b : Nat × Nat × Int) : Bool :=
  a.1 < b.1 ∨ (a.1 = b.1 ∧ (a.2.1 < b.2.1 ∨ (a.2.1 = b.2.1 ∧ a.2.2 < b.2.2)))

def merge3Aux : Nat → S3 → S3 → S3
  | 0, a, b => a ++ b
  | _ + 1, [], b => b
  | _ + 1, a, [] => a
  | n + 1, (ka, ca) :: ra, (kb, cb) :: rb =>
    if ka = kb then (if ca + cb = 0 then merge3Aux n ra rb else (ka, ca + cb) :: merge3Aux n ra rb)
    else if ltKey3 ka kb then (ka, ca) :: merge3Aux n ra ((kb, cb) :: rb)
    else (kb, cb) :: merge3Aux n ((ka, ca) :: ra) rb

def merge3 (a b : S3) : S3 := merge3Aux (a.length + b.length) a b

def addTerm3 (s : S3) (k : Nat × Nat × Int) (c : Int) : S3 :=
  if c = 0 then s else merge3 s [(k, c)]

/-- Product truncated at `l ≤ L1`, `k2 ≤ K1`: each term of `b` shifts `a`, which stays sorted,
and the shifted copies are merged (`b` is the short factor in every use). -/
def S3.mul (a b : S3) (L1 K1 : Nat) : S3 :=
  b.foldl (fun acc tb =>
    merge3 acc ((a.filter (fun ta => ta.1.1 + tb.1.1 ≤ L1 ∧ ta.1.2.1 + tb.1.2.1 ≤ K1)).map
      (fun ta => ((ta.1.1 + tb.1.1, ta.1.2.1 + tb.1.2.1, ta.1.2.2 + tb.1.2.2), ta.2 * tb.2)))) []

def S3.coeff (a : S3) (k : Nat × Nat × Int) : Int :=
  match a.find? (fun t => t.1 = k) with
  | some t => t.2
  | none => 0

/-- `(1 - X)^{-c}` with `X = e^{2πi(k'σ + lρ + jv)}`, truncated at `X^nmax`. -/
def binomSeries (l k2 : Nat) (j c : Int) (nmax : Nat) : S3 :=
  if c = 0 then [((0, 0, 0), 1)] else
  (List.range (nmax + 1)).foldl (fun acc n =>
    if c > 0 then
      addTerm3 acc (l * n, k2 * n, j * n) (choose (c.toNat + n - 1) n : Int)
    else if n ≤ (-c).toNat then
      addTerm3 acc (l * n, k2 * n, j * n) (parity n * (choose (-c).toNat n : Int))
    else acc) []

/-- One step of the product: all factors with a fixed `l` and `k2 = 0, …, K1`,
multiplied into `ser`; `none` if an exponent is not an integer. -/
def chunk (G : Genera) (N L1 K1 l : Nat) (ser : S3) : Option S3 :=
  (List.range (K1 + 1)).foldl (fun oser k2 =>
    match oser with
    | none => none
    | some ser =>
      if l = 0 ∧ k2 = 0 then some ser else
      let fourN := 4 * k2 * l / N        -- 4 k' l, an integer since N | 4 k2 l for N = 1, 2
      let jmax := fourN + 2
      let nmaxp :=
        let a := if l > 0 then L1 / l else K1 / k2
        if k2 > 0 then min a (K1 / k2) else a
      (List.range (2 * jmax + 1)).foldl (fun oser2 (i : Nat) =>
        match oser2 with
        | none => none
        | some ser2 =>
          let j : Int := (i : Int) - jmax
          match expo G N k2 l j with
          | none => none
          | some c => if c = 0 then some ser2 else some (S3.mul ser2 (binomSeries l k2 j c nmaxp) L1 K1))
        (some ser)) (some ser)

/-- The factors with `l ≤ lmax`, multiplied in the order `l = 0, 1, …`. -/
def productPartUpTo (G : Genera) (N L1 K1 : Nat) : Nat → Option S3
  | 0 => chunk G N L1 K1 0 [((0, 0, 0), 1)]
  | l + 1 => (productPartUpTo G N L1 K1 l).bind (chunk G N L1 K1 (l + 1))

/-- The multiplicative part of `1/Φ`: all factors with `(k', l) ≠ (0, 0)`, `l ≤ Lmax + 1`,
`k2 ≤ Kmax2 + kshift`. -/
def productPart (G : Genera) (N Lmax Kmax2 kshift : Nat) : Option S3 :=
  productPartUpTo G N (Lmax + 1) (Kmax2 + kshift) (Lmax + 1)

def maxAbsP (s : S3) : Nat := s.foldl (fun m t => max m t.1.2.2.natAbs) 0

/-- The last step: the prefactor `e^{-2πi(ρ + σ/N + v)}` and the factor
`(1 - e^{-2πiv})^{-c(-1)}` expanded in powers of `e^{-2πiv}` (chamber R) or of
`e^{+2πiv}` (chamber L), applied to the product `ser`. -/
def finishTable (G : Genera) (N Lmax Kmax2 Pmax kshift : Nat) (chamberR : Bool) (ser : S3) :
    Option S3 :=
  match expo G N 0 0 (-1), expo G N 0 0 (-2) with
  | some c1, some 0 =>
    let c1n := c1.toNat
    let prange := maxAbsP ser + Pmax + 2
    let vser : S3 := (List.range (prange + 1)).foldl (fun acc (n : Nat) =>
      if chamberR then addTerm3 acc (0, 0, -((n : Int) + 1)) ((choose (c1n + n - 1) n : Nat) : Int)
      else addTerm3 acc (0, 0, c1 - 1 + (n : Int)) (parity c1n * ((choose (c1n + n - 1) n : Nat) : Int))) []
    let full := S3.mul ser vser (Lmax + 1) (Kmax2 + kshift)
    some ((full.filter (fun t => 1 ≤ t.1.1 ∧ kshift ≤ t.1.2.1 ∧ t.1.2.2.natAbs ≤ Pmax)).map
      (fun t => ((t.1.1 - 1, t.1.2.1 - kshift, t.1.2.2), t.2)))
  | _, _ => none

/-- Coefficients of `1/Φ`, keyed by `(l, k2, p)` with `l = N Q^2/2`, `k2 = P^2/2`, `p = Q·P`. -/
def coefficientTable (G : Genera) (N Lmax Kmax2 Pmax kshift : Nat) (chamberR : Bool) : Option S3 :=
  (productPart G N Lmax Kmax2 kshift).bind (finishTable G N Lmax Kmax2 Pmax kshift chamberR)


/-! ### Reading the certificates

The intermediate series of the product expansion are stored in the file as natural numbers:
a list of integers `x_0, x_1, …` is written as `Σ z_i 2^{64 i}` with `z = 2x` for `x ≥ 0`
and `z = -2x - 1` for `x < 0`, and `ints k n` reads `k` integers back.  A series in three
variables is the list of quadruples `l k2 p c`, a series in two variables the list of
triples `x y c`. -/

def decodeInts : Nat → Nat → List Int
  | 0, _ => []
  | k + 1, n =>
    let z := n % 18446744073709551616
    (if z % 2 = 0 then ((z / 2 : Nat) : Int) else -(((z + 1) / 2 : Nat) : Int)) ::
      decodeInts k (n / 18446744073709551616)

def ints (k n : Nat) : List Int := decodeInts k n

def toS3 : List Int → S3
  | l :: k :: p :: c :: rest => ((l.toNat, k.toNat, p), c) :: toS3 rest
  | _ => []

def toS2 : List Int → S2
  | x :: y :: c :: rest => ((x.toNat, y), c) :: toS2 rest
  | _ => []

def sgn (p : Int) : Int := if (p + 1) % 2 = 0 then 1 else -1

/-- The index `d = (-1)^{Q·P+1} ×` coefficient. -/
def dIndex (t : Option S3) (l k2 : Nat) (p : Int) : Option Int :=
  match t with
  | none => none
  | some s => some (sgn p * S3.coeff s (l, k2, p))


/-! ### The heterotic string on `T^6`: `1/Φ_10` -/

/-- Table of `1/Φ_10` for `Q^2/2 = l`, `P^2/2 = k2` in `{1,2,3}`, `|Q·P| ≤ 6`;
`xmax` is chosen as in the Python script: `8 (Kmax2 + 1)(Lmax + 1) + 16 = 144`. -/
def hetTable (chamberR : Bool) : Option S3 :=
  coefficientTable (generaHet (8 * 4 * 4 + 16)) 1 3 3 6 1 chamberR

/-- `d_h(n)`: coefficient of `q^{n}` in `q η^{-24}`, `n = Q^2/2 + 1 ≥ 0`. -/
def dh (n : Nat) : Int := S2.coeff (etaInvPow 24 (8 * n)) (8 * n, 0)

theorem dh_values : [dh 0, dh 1, dh 2, dh 3, dh 4] = [1, 24, 324, 3200, 25650] := by
  decide +kernel

/-- Wall crossing, `d_R - d_L = (-1)^{Q·P} Q·P d_h(Q) d_h(P)`, read off two tables. -/
def wallCrossingOf (tR tL : Option S3) : Bool :=
  (List.range 3).all fun m' => (List.range 3).all fun n' => (List.range 9).all fun i =>
    let m := m' + 1
    let n := n' + 1
    let p : Int := (i : Int) - 4
    match dIndex tR m n p, dIndex tL m n p with
    | some dR, some dL => dR - dL = (if p % 2 = 0 then 1 else -1) * p * dh (m + 1) * dh (n + 1)
    | _, _ => false

/-- Wall crossing for `Q^2, P^2 ∈ {2,4,6}`, `|Q·P| ≤ 4`, between the two chambers. -/
def wallCrossingHolds : Bool := wallCrossingOf (hetTable true) (hetTable false)

/-- The rows `(Q^2, P^2) = (2,2), (4,2), (6,2), (4,4), (6,4), (6,6)`, `Q·P = -2, …, 4` of a table. -/
def hetRows (t : Option S3) : List (List (Option Int)) :=
  [(1, 1), (2, 1), (3, 1), (2, 2), (3, 2), (3, 3)].map fun (mn : Nat × Nat) =>
    (List.range 7).map (fun (i : Nat) => dIndex t mn.1 mn.2 ((i : Int) - 2))

/-! ### The `Z_2` toroidal orbifold: failure of positivity -/

/-- Chattopadhyaya–David's condition (4.7) for a single-centred charge, `N = 2`. -/
def singleCentredZ2 (q2 p2 qp : Int) : Bool :=
  q2 > 0 ∧ p2 > 0 ∧ q2 * p2 > qp * qp ∧ 2 * q2 + p2 - 3 * qp ≥ 0 ∧
    2 * q2 ≥ qp ∧ p2 ≥ qp ∧ qp ≥ 0

/-- The table of the `Z_2` orbifold in chamber R, `l = Q^2`, `k2 = P^2/2`; no prefactor
`e^{2πiσ/N}` (`kshift = 0`); `xmax = 8 ⌊(Kmax2 (Lmax + 1) + 1)/2⌋ + 16`. -/
def tor2Table (Lmax Kmax2 Pmax : Nat) : Option S3 :=
  coefficientTable (generaTor2 (8 * ((Kmax2 * (Lmax + 1) + 1) / 2) + 16)) 2 Lmax Kmax2 Pmax 0 true

/-- The rows `Q^2 = 0, …, lmax` of a table at `P^2 = 2 k2`, `Q·P = 0, 1, 2`. -/
def tor2Rows (t : Option S3) (k2 lmax : Nat) : List (List (Option Int)) :=
  (List.range (lmax + 1)).map fun (l : Nat) => (List.range 3).map fun (p : Nat) => dIndex t l k2 p

/-- The twenty-one charges of Table 2 of the paper: `(Q^2, P^2, Q·P, d)`. -/
def violations : List (Nat × Nat × Int × Int) :=
  [(1, 2, 0, -224), (1, 4, 0, -1248), (2, 2, 1, -256), (3, 2, 0, -3392), (3, 4, 0, -10320),
   (4, 2, 1, -3840), (5, 2, 0, -30336), (5, 2, 2, -3392), (5, 4, 0, -55424), (6, 2, 1, -33536),
   (7, 2, 0, -202560), (7, 2, 2, -30336), (7, 4, 0, -179022), (8, 2, 1, -220672),
   (9, 2, 0, -1118496), (9, 2, 2, -202560), (9, 4, 0, -155232), (10, 2, 1, -1204992),
   (11, 2, 0, -5374656), (11, 2, 2, -1118496), (12, 2, 1, -5741824)]

/-- A listed charge has the listed index in the table. -/
def violationIndex (ta : Option S3) (t : Nat × Nat × Int × Int) : Bool :=
  dIndex ta t.1 (t.2.1 / 2) t.2.2.1 = some t.2.2.2

theorem violations_single_centred :
