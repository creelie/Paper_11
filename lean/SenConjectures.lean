/-! ### Certificates

The two expansions used by the paper: the `Z_2` orbifold with `P^2 ≤ 4` up to `Q^2 = 12`
(`tor2`) and `1/Φ_10` with `Q^2, P^2 ≤ 6` (`het`).  Each certificate is checked step by step. -/

theorem upTo_succ (G : Genera) (N L1 K1 l : Nat) :
    productPartUpTo G N L1 K1 (l + 1) =
      (productPartUpTo G N L1 K1 l).bind (chunk G N L1 K1 (l + 1)) := rfl

theorem productPart_def (G : Genera) (N Lmax Kmax2 kshift : Nat) :
    productPart G N Lmax Kmax2 kshift =
      productPartUpTo G N (Lmax + 1) (Kmax2 + kshift) (Lmax + 1) := rfl

theorem coefficientTable_def (G : Genera) (N Lmax Kmax2 Pmax kshift : Nat) (c : Bool) :
    coefficientTable G N Lmax Kmax2 Pmax kshift c =
      (productPart G N Lmax Kmax2 kshift).bind (finishTable G N Lmax Kmax2 Pmax kshift c) := rfl


