  (upTo_succ Ghet144 1 4 4 3).trans
    ((congrArg (fun o => Option.bind o (chunk Ghet144 1 4 4 4)) het_upTo_3).trans het_step_4)

theorem tabHR_finish :
    Option.bind (some het_4) (finishTable Ghet144 1 3 3 6 1 true) = some tabHR := by
  decide +kernel

theorem tabHR_table : hetTable true = some tabHR :=
  (show hetTable true = coefficientTable (generaHet 144) 1 3 3 6 1 true from rfl).trans <|
  (congrArg (fun g => coefficientTable g 1 3 3 6 1 true) het_genera).trans <|
  (coefficientTable_def Ghet144 1 3 3 6 1 true).trans <|
  (congrArg (fun o => Option.bind o (finishTable Ghet144 1 3 3 6 1 true)) (productPart_def Ghet144 1 3 3 1)).trans <|
