  (upTo_succ Ghet144 1 4 4 1).trans
    ((congrArg (fun o => Option.bind o (chunk Ghet144 1 4 4 2)) het_upTo_1).trans het_step_2)

theorem het_step_3 :
    Option.bind (some het_2) (chunk Ghet144 1 4 4 3) = some het_3 := by
  decide +kernel

