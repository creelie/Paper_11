theorem het_genera : generaHet 144 = Ghet144 := by decide +kernel

theorem het_step_0 : chunk Ghet144 1 4 4 0 [((0, 0, 0), 1)] = some het_0 := by
  decide +kernel

theorem het_upTo_0 : productPartUpTo Ghet144 1 4 4 0 = some het_0 := het_step_0

theorem het_step_1 :
    Option.bind (some het_0) (chunk Ghet144 1 4 4 1) = some het_1 := by
  decide +kernel

theorem het_upTo_1 : productPartUpTo Ghet144 1 4 4 1 = some het_1 :=
  (upTo_succ Ghet144 1 4 4 0).trans
    ((congrArg (fun o => Option.bind o (chunk Ghet144 1 4 4 1)) het_upTo_0).trans het_step_1)

theorem het_step_2 :
    Option.bind (some het_1) (chunk Ghet144 1 4 4 2) = some het_2 := by
  decide +kernel

