\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces The index $d(Q,P) = (-1)^{Q\cdot P+1}c(Q,P)$ of quarter-BPS dyons of the heterotic string on $T^6$, from $1/\Phi _{10}$, in the chamber $\operatorname  {Im} v<0$ (the expansion in powers of $e^{-2\pi i v}$). The table agrees entry by entry with Table\nonbreakingspace 1 of \cite  {Sen11positivity}. Entries with $Q\cdot P<0$ are the other chamber's values at $|Q\cdot P|$ by the symmetry $v\DOTSB \mapstochar \rightarrow -v$; their negativity for $Q\cdot P\le -1$ is the two-centred contribution of Theorem\nonbreakingspace \ref {thm:wallcrossing}.}}{52}{table.7}\protected@file@percent }
\newlabel{tab:phi10}{{7}{52}{The index $d(Q,P) = (-1)^{Q\cdot P+1}c(Q,P)$ of quarter-BPS dyons of the heterotic string on $T^6$, from $1/\Phi _{10}$, in the chamber $\operatorname {Im} v<0$ (the expansion in powers of $e^{-2\pi i v}$). The table agrees entry by entry with Table~1 of \cite {Sen11positivity}. Entries with $Q\cdot P<0$ are the other chamber's values at $|Q\cdot P|$ by the symmetry $v\mapsto -v$; their negativity for $Q\cdot P\le -1$ is the two-centred contribution of Theorem~\ref {thm:wallcrossing}}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces The index $d(Q,P)$ of quarter-BPS dyons in the $\mathbb  {Z}_2$ toroidal orbifold of type IIB on $T^6$, from the product formula for $1/\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \Phi $}\mathaccent "0365{\Phi }_2$ with the twisted elliptic genera \eqref  {eq:tor2genera}, in the chamber $\operatorname  {Im} v<0$ and with the normalisation of Remark\nonbreakingspace \ref {rem:normalisation}. The entries agree with Tables\nonbreakingspace 17, 18 and\nonbreakingspace 19 of \cite  {CD19} in their common range $Q^2\le 12$, except the entry $Q^2=4$, $P^2=2$, $Q\cdot P=0$, printed there as $-11\,520$: the product formula gives $+11\,520$, and the sign rule $(-1)^{Q^2}$ for $P^2=2$ stated in the same section of \cite  {CD19} requires the positive value. The column $P^2=0$ lies outside the single-centred cone; its sign is $(-1)^{Q^2}$. The negative entries inside the cone are those of Table\nonbreakingspace \ref {tab:violations}.}}{52}{table.8}\protected@file@percent }
\newlabel{tab:tor2}{{8}{52}{The index $d(Q,P)$ of quarter-BPS dyons in the $\ZZ _2$ toroidal orbifold of type IIB on $T^6$, from the product formula for $1/\Phit _2$ with the twisted elliptic genera \eqref {eq:tor2genera}, in the chamber $\operatorname {Im} v<0$ and with the normalisation of Remark~\ref {rem:normalisation}. The entries agree with Tables~17, 18 and~19 of \cite {CD19} in their common range $Q^2\le 12$, except the entry $Q^2=4$, $P^2=2$, $Q\cdot P=0$, printed there as $-11\,520$: the product formula gives $+11\,520$, and the sign rule $(-1)^{Q^2}$ for $P^2=2$ stated in the same section of \cite {CD19} requires the positive value. The column $P^2=0$ lies outside the single-centred cone; its sign is $(-1)^{Q^2}$. The negative entries inside the cone are those of Table~\ref {tab:violations}}{table.8}{}}
